# Copy to .env and adjust. See src/plugins/env.ts for defaults and validation.

# development | production | test
NODE_ENV=development

# HTTP listen address (defaults: localhost)
HOST=localhost

# Port as string (default: 8000)
PORT=8000

# CORS: empty or * = allow any origin. Otherwise comma-separated full origins
# (scheme + host + non-default port), e.g. http://localhost:3000,https://app.example.com
CORS_ORIGIN=

# Supabase project shared with the main club site. Used to verify access tokens
# (JWKS at {SUPABASE_URL}/auth/v1/.well-known/jwks.json) and to read `profiles`.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Neon Object Storage (S3-compatible) for riddle images. Optional: image routes
# return 503 until all five are set. Paste the four AWS_* values exactly as Neon
# gives them (its generated .env / `neon env pull`). Use a *private* bucket on
# the database's branch and a credential with storage:read + storage:write.
# Docs: https://neon.com/docs/storage
AWS_ENDPOINT_URL_S3=     # the branch's s3_endpoint, e.g. https://br-xxx.storage.c-11.us-east-1.aws.neon.tech
AWS_REGION=              # e.g. us-east-1
AWS_ACCESS_KEY_ID=       # credential token_id
AWS_SECRET_ACCESS_KEY=   # credential s3_secret_access_key
S3_BUCKET=               # bucket name, e.g. riddle-images
